# Скопируй значения в Coolify → Environment Variables
# (файл сам по себе не монтируется — переменные задаются в UI Coolify)

# ОБЯЗАТЕЛЬНО
SFU_ANNOUNCED_IP=37.48.253.62
SERVER_HOST_URL=https://meet.example.com

# Рекомендуется
SFU_NUM_WORKERS=4

# Уже есть дефолты в docker-compose.yaml:
# UI_LANGUAGE=ru
# APP_NAME=MiroTalk SFU
# SFU_SERVER=true
# SFU_MIN_PORT=40000
# SFU_MAX_PORT=40100
# HOST_PROTECTED=false
# RECORDING_ENABLED=false

# Пример защиты хоста:
# HOST_PROTECTED=true
# HOST_USER_AUTH=true
# HOST_USERS=admin:СмениПароль:Админ:*
