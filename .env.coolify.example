# Скопируй значения в Coolify → Environment Variables
# (файл сам по себе не монтируется — переменные задаются в UI Coolify)

# ОБЯЗАТЕЛЬНО
SFU_ANNOUNCED_IP=37.48.253.62
SERVER_HOST_URL=https://meet.example.com

# PostgreSQL из self-hosted Supabase
# Скопируй DATABASE_URL из Internal Connection String PostgreSQL-ресурса Supabase в Coolify.
# Здесь оставлено пусто намеренно: строка содержит пароль и не должна попадать в Git.
DATABASE_URL=
# Для внутреннего подключения Supabase TLS обычно не нужен.
DATABASE_SSL=false
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=10000
DATABASE_IDLE_TIMEOUT_MS=30000

# Рекомендуется
SFU_NUM_WORKERS=4

# AI-чаты скрыты (включить только с ключами)
ENABLE_CHAT_GPT=false
ENABLE_DEEP_SEEK=false
CHATGPT_ENABLED=false
DEEP_SEEK_ENABLED=false
VIDEOAI_ENABLED=false

# Распознавание речи
SHOW_TRANSCRIPTION=false
SHOW_SPEECH_REC_BUTTON=false
SHOW_CHAT_SPEECH=false

# Чат
SHOW_CHAT_MARKDOWN=false

# Уже есть дефолты в docker-compose.yaml:
# UI_LANGUAGE=ru
# APP_NAME=MiroTalk SFU
# SFU_SERVER=true
# SFU_MIN_PORT=40000
# SFU_MAX_PORT=40100
# HOST_PROTECTED=false
# RECORDING_ENABLED=false

# Пример защиты хоста:
# HOST_PROTECTED=true
# HOST_USER_AUTH=true
# HOST_USERS=admin:СмениПароль:Админ:*

# --- Авторизация по телефону (обязательна для join/create) ---
PHONE_AUTH_ENABLED=true
# Bootstrap-роли первого запуска БД; дальше роли управляются в супер-админке
PHONE_CREATORS=+79001234567,+79007654321
# Первый супер-администратор: общая статистика, пользователи и скрытое наблюдение
PHONE_SUPERADMINS=+79001234567
# Временно: источник для одноразового импорта в PostgreSQL (volume mirotalksfu-phone-data)
PHONE_STORE_PATH=/src/app/data/phone-store.json
TELEGRAM_GATEWAY_TOKEN=
TELEGRAM_GATEWAY_API_URL=https://gatewayapi.telegram.org/
# Без прокси Telegram Gateway не заведётся
PROXY_URL=http://user:pass@host:port
# Fallback SMS (SMSC.ru), если номер не в Telegram
SMSC_LOGIN=
SMSC_PASSWORD=
SMSC_SENDER=
SMSC_MESSAGE_TEMPLATE=Код входа в видеоконференцию OPTRF: %CODE%
